      "targets": [
        {
          "dataset": "earthquake",
          "datasource": {
            "type": "mysql",
            "uid": "bg0evlngt9o8we"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  CASE e.region WHEN 'Taipei' THEN '台北' WHEN 'Hsinchu' THEN '新竹'\n                WHEN 'Taichung' THEN '台中' WHEN 'Tainan' THEN '台南' END AS 廠區,\n  eq.earthquake_time                                        AS 地震時間,\n  e.id                                                      AS EventID,\n  el.intensity                                              AS 震度,\n  e.level                                                   AS `Event Severity`,\n  CASE WHEN e.level = 'NA' THEN 'NA'\n       WHEN e.trigger_alert = 1 THEN '否' ELSE '是' END      AS 警報抑制,\n  IF(e.trigger_alert = 1, e.create_at, NULL)                AS 警報發送時間,\n  CASE WHEN e.is_done = 1 AND e.process_time = -1 THEN '自動關閉'\n       WHEN e.is_done = 1   THEN '已完成'\n       WHEN e.is_damage = 1 THEN '維修中'\n       WHEN e.ack = 1       THEN '待處理'\n       ELSE '未接收' END                                     AS 處理狀態,\n  CASE e.is_damage WHEN 1 THEN '是' WHEN 0 THEN '否' ELSE '-' END            AS 損傷與否,\n  CASE e.is_operation_active WHEN 1 THEN '是' WHEN 0 THEN '否' ELSE '-' END  AS 啟動戰情,\n  IFNULL(TIME_FORMAT(TIMEDIFF(e.report_at, e.create_at), '%H:%i:%s'), '-')  AS 回報時長\nFROM event e\nJOIN earthquake_location el ON e.location_eq_id = el.id\nJOIN earthquake eq          ON el.earthquake_id = eq.id\nWHERE e.region IN (${region:sqlstring})\n  AND $__timeFilter(eq.earthquake_time)\nORDER BY eq.earthquake_time DESC, e.region",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "",
      "type": "table"
    }
