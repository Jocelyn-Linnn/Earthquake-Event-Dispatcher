          "rawQuery": true,
          "rawSql": "SELECT CONCAT(FLOOR(t / 60), 'h', LPAD(MOD(t, 60), 2, '0'), 'm') AS `Avg Handling Time`\nFROM (\n  SELECT ROUND(AVG(e.process_time)) AS t\n  FROM event e\n  JOIN earthquake_location el ON e.location_eq_id = el.id\n  JOIN earthquake eq          ON el.earthquake_id = eq.id\n  WHERE e.region = '${region}'\n    AND $__timeFilter(eq.earthquake_time)\n    AND e.process_time >= 0\n) x",
          "refId": "A",
