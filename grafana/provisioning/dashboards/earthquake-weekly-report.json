      "targets": [
        {
          "dataset": "earthquake",
          "datasource": {
            "type": "mysql",
            "uid": "bg0evlngt9o8we"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  CASE e.region WHEN 'Taipei' THEN '台北' WHEN 'Hsinchu' THEN '新竹'\n                WHEN 'Taichung' THEN '台中' WHEN 'Tainan' THEN '台南' END AS 廠區,\n  eq.earthquake_time AS 地震時間,\n  el.intensity       AS 震度,\n  CASE e.is_damage WHEN 1 THEN '是' WHEN 0 THEN '否' ELSE '-' END AS 損傷與否,\n  e.report_at        AS 回報時間,\n  CASE WHEN e.process_time >= 0\n         THEN CONCAT(FLOOR(e.process_time / 60), 'h', LPAD(MOD(e.process_time, 60), 2, '0'), 'm')\n       WHEN e.process_time = -1 THEN '未處理'\n       ELSE '-' END  AS 處理時間\nFROM event e\nJOIN earthquake_location el ON e.location_eq_id = el.id\nJOIN earthquake eq          ON el.earthquake_id = eq.id\nWHERE eq.id = '${earthquake}'\nORDER BY FIELD(e.region, 'Taipei', 'Hsinchu', 'Taichung', 'Tainan')",
          "refId": "A",
          "sql": {
